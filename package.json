{
  "name": "ip-mlz-no",
  "version": "1.0.0",
  "private": true,
  "description": "\"What is my IP\" — a static site with a small Go Cloud Run backend, served from Firebase Hosting.",
  "homepage": "https://ip.mlz.no",
  "author": "Martin Zachariassen <hi@mlz.no>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinzachariassen/ip-mlz-no.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "firebase emulators:start --only hosting",
    "dev:server": "cd server && go run .",
    "test:server": "cd server && go vet ./... && go test ./...",
    "format": "biome check --write .",
    "lint": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "firebase-tools": "^15.34.0"
  }
}
